<script type="module">
    // --- FITUR AUTO FULLSCREEN ---
    function enforceFullscreen() {
        if (!document.fullscreenElement && !document.webkitFullscreenElement) {
            const docEl = document.documentElement;
            if (docEl.requestFullscreen) {
                docEl.requestFullscreen().catch(err => console.log("Fullscreen blocked: ", err));
            } else if (docEl.webkitRequestFullscreen) { 
                docEl.webkitRequestFullscreen();
            }
        }
    }
    document.body.addEventListener('click', enforceFullscreen);
    document.body.addEventListener('touchstart', enforceFullscreen, { passive: true });

    // INTEGRASI FIREBASE WUSHU SANDA
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { getDatabase, ref, set, onValue } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

    const firebaseConfig = {
      apiKey: "AIzaSyCUhrQj0vxKYDtf1iSJVetY6gQ5K932blM",
      authDomain: "wushu-sanda-b85dc.firebaseapp.com",
      databaseURL: "https://wushu-sanda-b85dc-default-rtdb.asia-southeast1.firebasedatabase.app",
      projectId: "wushu-sanda-b85dc",
      storageBucket: "wushu-sanda-b85dc.firebasestorage.app",
      messagingSenderId: "335593032214",
      appId: "1:335593032214:web:65e2186bee003408c48337"
    };

    const app = initializeApp(firebaseConfig);
    const database = getDatabase(app);
    const dbRef = ref(database, 'wushu_sanda_scoring'); 

    // Struktur Default
    const DEFAULT_STATE = {
        timer: 120, babak: 1, isRunning: false, bertandingIdx: -1, pointGap: 12,
        matches: [],
        merah: { 
            baseScore: [0,0,0], actions: [], roundWins: [false,false,false],
            juri: { j1: [0,0,0], j2: [0,0,0], j3: [0,0,0], j4: [0,0,0], j5: [0,0,0] }
        },
        biru: { 
            baseScore: [0,0,0], actions: [], roundWins: [false,false,false],
            juri: { j1: [0,0,0], j2: [0,0,0], j3: [0,0,0], j4: [0,0,0], j5: [0,0,0] }
        },
        juriStatus: { j1: true, j2: true, j3: true, j4: true, j5: true }
    };

    window.wushuState = DEFAULT_STATE;
    let pendingCallback = null;

    // --- FIREBASE LISTENERS ---
    onValue(dbRef, (snapshot) => {
        const data = snapshot.val();
        if (data) {
            ['merah', 'biru'].forEach(side => {
                if (!data[side]) data[side] = {};
                if (!data[side].baseScore) data[side].baseScore = [0,0,0];
                if (!data[side].actions) data[side].actions = [];
                if (!data[side].roundWins) data[side].roundWins = [false,false,false];
                if (!data[side].juri) data[side].juri = { j1:[0,0,0], j2:[0,0,0], j3:[0,0,0], j4:[0,0,0], j5:[0,0,0] };
            });

            window.wushuState = data;
            updateUI();
            
            const badge = document.getElementById('sync-indicator');
            badge.classList.add('show');
            setTimeout(() => badge.classList.remove('show'), 500);
        } else {
            set(dbRef, DEFAULT_STATE);
        }
    });

    window.broadcast = function(path, value) {
        if(path === "ALL") set(dbRef, value);
        else set(ref(database, 'wushu_sanda_scoring/' + path), value);
    }

    // --- FUNGSI KALKULASI SANDA (MENYUNTIKKAN POIN KE JURI) ---
    
    // 1. Menghitung Poin Penalti Lawan (Hanya nilai tambahan mutlak)
    function getPenaltyPoints(side, roundIndex) {
        const state = window.wushuState;
        const opp = side === 'merah' ? 'biru' : 'merah';
        const oppCau = state[opp].actions.filter(a => a.type === 'caution' && a.round === roundIndex + 1).length;
        const opp8c = state[opp].actions.filter(a => a.type === '8count' && a.round === roundIndex + 1).length;
        const oppOut = state[opp].actions.filter(a => a.type === 'ringout' && a.round === roundIndex + 1).length;
        
        // Peringatan, 8-Count, dan Jatuh Keluar Matras memberi +2 pada lawan
        return (oppCau * 2) + (opp8c * 2) + (oppOut * 2); 
    }

    // 2. Mendapatkan Skor Akhir Juri Spesifik (Tombol Juri + Tombol Manual + Suntikan Penalti)
    function getJudgeScore(side, judgeNum, roundIndex) {
        const state = window.wushuState;
        const jKey = 'j' + judgeNum;
        
        const rawScore = (state[side].juri && state[side].juri[jKey] && state[side].juri[jKey][roundIndex]) ? state[side].juri[jKey][roundIndex] : 0;
        const manualBase = state[side].baseScore[roundIndex] || 0; 
        const penalties = getPenaltyPoints(side, roundIndex); 
        
        return rawScore + manualBase + penalties;
    }

    // --- UI UPDATER UTAMA ---
    function updateUI() {
        const state = window.wushuState;
        let activeMatch = null;
        if (state.bertandingIdx !== undefined && state.bertandingIdx >= 0 && state.matches) {
            activeMatch = state.matches[state.bertandingIdx];
        }

        if (activeMatch) {
            document.getElementById('dw-match-info').innerText = `PARTAI ${activeMatch.p} - ${activeMatch.kelas} ${activeMatch.cat} ${activeMatch.gender}`;
            document.getElementById('dw-m-name').innerText = activeMatch.m || "MERAH";
            document.getElementById('dw-m-kont').innerText = activeMatch.km || "KONTINGEN MERAH";
            document.getElementById('dw-b-name').innerText = activeMatch.b || "BIRU";
            document.getElementById('dw-b-kont').innerText = activeMatch.kb || "KONTINGEN BIRU";
        }

        document.getElementById('dw-babak-disp').innerText = `RONDE ${state.babak}`;
        const mStr = Math.floor(state.timer / 60).toString().padStart(2, '0');
        const sStr = (state.timer % 60).toString().padStart(2, '0');
        document.getElementById('dw-timer-disp').innerText = `${mStr}:${sStr}`;

        // Update Lampu Juri Header (Koneksi)
        if (state.juriStatus) {
            for(let i=1; i<=5; i++) {
                let lamp = document.getElementById('lamp-j' + i);
                if(lamp) lamp.className = 'juri-lamp ' + (state.juriStatus['j'+i] ? 'lamp-on' : 'lamp-off');
            }
        }

        // ================= KALKULASI KEMENANGAN RONDE (MAYORITAS JURI) =================
        let roundWinsChanged = false;
        let mTotalRoundsWon = 0;
        let bTotalRoundsWon = 0;

        for (let r = 0; r < 3; r++) {
            let mVotes = 0;
            let bVotes = 0;
            
            for(let i=1; i<=5; i++) {
                let scoreM = getJudgeScore('merah', i, r);
                let scoreB = getJudgeScore('biru', i, r);
                
                if (scoreM > scoreB) mVotes++;
                else if (scoreB > scoreM) bVotes++;
            }
            
            let mWin = mVotes > bVotes;
            let bWin = bVotes > mVotes;

            if (state.merah.roundWins[r] !== mWin) { state.merah.roundWins[r] = mWin; roundWinsChanged = true; }
            if (state.biru.roundWins[r] !== bWin) { state.biru.roundWins[r] = bWin; roundWinsChanged = true; }
            
            if (state.merah.roundWins[r]) mTotalRoundsWon++;
            if (state.biru.roundWins[r]) bTotalRoundsWon++;
        }
        
        if (roundWinsChanged) {
            window.broadcast('merah/roundWins', state.merah.roundWins);
            window.broadcast('biru/roundWins', state.biru.roundWins);
        }

        // --- RENDER SKOR RAKSASA ---
        document.getElementById('score-m').innerText = mTotalRoundsWon;
        document.getElementById('score-b').innerText = bTotalRoundsWon;

        document.getElementById('score-m').classList.toggle('text-glow-green', mTotalRoundsWon >= 2);
        document.getElementById('score-b').classList.toggle('text-glow-green', bTotalRoundsWon >= 2);

        // Tracker Penalti
        ['merah', 'biru'].forEach(side => {
            const prefix = side === 'merah' ? 'm' : 'b';
            const acts = state[side].actions.filter(a => a.round === state.babak); 
            
            document.getElementById(`trk-${prefix}-warn`).innerText = acts.filter(a => a.type === 'warning').length;
            document.getElementById(`trk-${prefix}-cau`).innerText = acts.filter(a => a.type === 'caution').length;
            document.getElementById(`trk-${prefix}-out`).innerText = acts.filter(a => a.type === 'ringout').length;
            document.getElementById(`trk-${prefix}-8c`).innerText = acts.filter(a => a.type === '8count').length;
        });

        // --- RENDER LAMPU KEMENANGAN RONDE (MERAH ATAU BIRU) ---
        // SUDUT MERAH
        document.getElementById(`m-win-1`).className = 'round-win-circle ' + (state.merah.roundWins[0] ? 'win-red' : '');
        document.getElementById(`m-win-2`).className = 'round-win-circle ' + (state.merah.roundWins[1] ? 'win-red' : '');
        document.getElementById(`m-win-3`).className = 'round-win-circle ' + (state.merah.roundWins[2] ? 'win-red' : '');

        // SUDUT BIRU (ID Terbalik berdasarkan layout flex-row-reverse)
        document.getElementById(`b-win-1`).className = 'round-win-circle ' + (state.biru.roundWins[0] ? 'win-blue' : '');
        document.getElementById(`b-win-2`).className = 'round-win-circle ' + (state.biru.roundWins[1] ? 'win-blue' : '');
        document.getElementById(`b-win-3`).className = 'round-win-circle ' + (state.biru.roundWins[2] ? 'win-blue' : '');


        // ================= UPDATE DATA PANEL TENGAH JURI =================
        const currentRoundIdx = (state.babak || 1) - 1;
        document.getElementById('mid-round-num').innerText = state.babak || '-';
        
        for (let i = 1; i <= 5; i++) {
            let mEl = document.getElementById('mid-m-j' + i);
            let bEl = document.getElementById('mid-b-j' + i);
            
            let jScoreM = getJudgeScore('merah', i, currentRoundIdx);
            let jScoreB = getJudgeScore('biru', i, currentRoundIdx);
            
            if(mEl && bEl) {
                mEl.innerText = jScoreM;
                bEl.innerText = jScoreB;
                
                // Reset styling base
                mEl.className = "w-[5.5vh] flex items-center justify-center text-white font-black text-[3vh] leading-none transition-all z-10 duration-300";
                bEl.className = "w-[5.5vh] flex items-center justify-center text-white font-black text-[3vh] leading-none transition-all z-10 duration-300";

                // Highlight logika pemenang pada angka
                if (jScoreM > jScoreB) {
                    mEl.classList.add('bg-red-500', 'shadow-[inset_0_0_1.5vh_rgba(0,0,0,0.3)]'); // Menyala Merah
                    bEl.classList.add('bg-blue-900', 'opacity-80'); // Meredup Biru Gelap
                } else if (jScoreB > jScoreM) {
                    mEl.classList.add('bg-red-900', 'opacity-80'); // Meredup Merah Gelap
                    bEl.classList.add('bg-blue-500', 'shadow-[inset_0_0_1.5vh_rgba(0,0,0,0.3)]'); // Menyala Biru
                } else {
                    // Seri (Tie)
                    mEl.classList.add('bg-[#dc2626]'); // Merah Normal
                    bEl.classList.add('bg-[#1d4ed8]'); // Biru Normal
                }
            }

            // Render Lampu Pemenang Juri secara Otomatis dan Serentak Berdasarkan Poin Terbanyak
            let lampMid = document.getElementById('mid-lamp-j' + i);
            if(lampMid) {
                if (jScoreM > jScoreB) {
                    // Lampu Menyala Merah (Sudut Merah Unggul)
                    lampMid.className = 'absolute right-[0.5vh] w-[2.5vh] h-[2.5vh] rounded-full border-[0.3vh] border-white bg-red-500 shadow-[0_0_1.5vh_#ef4444] transition-all duration-300';
                } else if (jScoreB > jScoreM) {
                    // Lampu Menyala Biru (Sudut Biru Unggul)
                    lampMid.className = 'absolute right-[0.5vh] w-[2.5vh] h-[2.5vh] rounded-full border-[0.3vh] border-white bg-blue-500 shadow-[0_0_1.5vh_#3b82f6] transition-all duration-300';
                } else {
                    // Lampu Mati / Redup Jika Poin Sama
                    lampMid.className = 'absolute right-[0.5vh] w-[2.5vh] h-[2.5vh] rounded-full border-[0.3vh] border-slate-500 bg-[#3a0a0a] shadow-[inset_0_0_1vh_rgba(0,0,0,0.8)] transition-all duration-300';
                }
            }
        }

        renderHistoryTable();
    }

    function renderHistoryTable() {
        const tbody = document.getElementById('history-table-body');
        let html = '';

        for (let r = 0; r < 3; r++) {
            
            // Hitung VOTE
            let mVotes = 0; let bVotes = 0;
            let mJ = []; let bJ = [];
            
            for(let i=1; i<=5; i++) {
                let sM = getJudgeScore('merah', i, r);
                let sB = getJudgeScore('biru', i, r);
                mJ.push(sM); bJ.push(sB);
                if (sM > sB) mVotes++; else if (sB > sM) bVotes++;
            }

            let penM = getPenaltyPoints('merah', r);
            let penB = getPenaltyPoints('biru', r);

            html += `
                <tr class="border-b border-slate-700 bg-slate-800 hover:bg-slate-700">
                    <td class="p-[1vh] font-bold text-center border-r border-slate-700" rowspan="2">Ronde ${r+1}</td>
                    <td class="p-[1vh] font-black text-red-400 uppercase">Merah</td>
                    <td class="p-[1vh] text-center border-l border-slate-700 text-slate-300 font-mono ${mJ[0]>bJ[0]?'text-white font-black':''}">${mJ[0]}</td>
                    <td class="p-[1vh] text-center text-slate-300 font-mono ${mJ[1]>bJ[1]?'text-white font-black':''}">${mJ[1]}</td>
                    <td class="p-[1vh] text-center text-slate-300 font-mono ${mJ[2]>bJ[2]?'text-white font-black':''}">${mJ[2]}</td>
                    <td class="p-[1vh] text-center text-slate-300 font-mono ${mJ[3]>bJ[3]?'text-white font-black':''}">${mJ[3]}</td>
                    <td class="p-[1vh] text-center text-slate-300 font-mono ${mJ[4]>bJ[4]?'text-white font-black':''}">${mJ[4]}</td>
                    <td class="p-[1vh] text-center border-l border-slate-700 font-bold text-yellow-400">+${penM} Total</td>
                    <td class="p-[1vh] text-center border-l border-slate-700 font-black text-red-400 text-[2.5vh]">${mVotes} <span class="text-[1.2vh] font-normal text-slate-400">Juri</span></td>
                </tr>
                <tr class="border-b-[0.4vh] border-slate-900 bg-slate-800/50 hover:bg-slate-700">
                    <td class="p-[1vh] font-black text-blue-400 uppercase">Biru</td>
                    <td class="p-[1vh] text-center border-l border-slate-700 text-slate-300 font-mono ${bJ[0]>mJ[0]?'text-white font-black':''}">${bJ[0]}</td>
                    <td class="p-[1vh] text-center text-slate-300 font-mono ${bJ[1]>mJ[1]?'text-white font-black':''}">${bJ[1]}</td>
                    <td class="p-[1vh] text-center text-slate-300 font-mono ${bJ[2]>mJ[2]?'text-white font-black':''}">${bJ[2]}</td>
                    <td class="p-[1vh] text-center text-slate-300 font-mono ${bJ[3]>mJ[3]?'text-white font-black':''}">${bJ[3]}</td>
                    <td class="p-[1vh] text-center text-slate-300 font-mono ${bJ[4]>mJ[4]?'text-white font-black':''}">${bJ[4]}</td>
                    <td class="p-[1vh] text-center border-l border-slate-700 font-bold text-yellow-400">+${penB} Total</td>
                    <td class="p-[1vh] text-center border-l border-slate-700 font-black text-blue-400 text-[2.5vh]">${bVotes} <span class="text-[1.2vh] font-normal text-slate-400">Juri</span></td>
                </tr>
            `;
        }
        tbody.innerHTML = html;
    }

    // --- LOGIKA TOMBOL MANUAL & HUKUMAN ---
    window.manualAdjust = function(side, val) {
        if(window.wushuState.bertandingIdx === -1) return alert("Belum ada partai aktif!");
        const roundIdx = (window.wushuState.babak || 1) - 1;
        let currentScore = (window.wushuState[side].baseScore[roundIdx] || 0) + val;
        window.broadcast(`${side}/baseScore/${roundIdx}`, currentScore);
    }

    window.applyWushuAction = function(side, type) {
        if(window.wushuState.bertandingIdx === -1) return alert("Belum ada partai aktif!");
        
        const actions = window.wushuState[side].actions || [];
        actions.push({ type: type, round: window.wushuState.babak });
        window.broadcast(`${side}/actions`, actions);
        
        if (type === 'ringout') {
            const outCount = actions.filter(a => a.type === 'ringout' && a.round === window.wushuState.babak).length;
            if (outCount >= 2) {
                setTimeout(() => {
                    const opp = side === 'merah' ? 'biru' : 'merah';
                    alert(`PELANGGARAN BERAT: SUDUT ${side.toUpperCase()} KELUAR MATRAS 2 KALI!\nRonde dimenangkan mutlak oleh Sudut ${opp.toUpperCase()}!`);
                    window.wushuState[opp].roundWins[window.wushuState.babak - 1] = true;
                    window.broadcast(`${opp}/roundWins`, window.wushuState[opp].roundWins);
                    window.broadcast('isRunning', false);
                }, 500);
            }
        }
    }

    // --- LOGIKA MODAL POP UP ---
    window.openModal = function(id) { document.getElementById(id).classList.add('active'); }
    window.closeModal = function(id) { document.getElementById(id).classList.remove('active'); }

    window.confirmAction = function(msg, callback) {
        document.getElementById('confirm-msg').innerText = msg;
        pendingCallback = callback;
        window.openModal('modal-confirm');
    }

    window.closeConfirm = function(proceed) {
        window.closeModal('modal-confirm');
        if (proceed && pendingCallback) {
            pendingCallback();
            window.closeModal('modal-controls');
        }
        pendingCallback = null;
    }

    window.executeAbsolute = function(winner) {
        const reason = document.getElementById('abs-reason').value;
        window.broadcast('isRunning', false); 
        window.closeModal('modal-absolute');
        
        setTimeout(() => {
            alert(`PERTANDINGAN DIHENTIKAN!\nPemenang: SUDUT ${winner.toUpperCase()}\nAlasan: ${reason}`);
            window.broadcast('monViewMode', 'winner');
            
            if(window.wushuState.bertandingIdx >= 0) {
                const matchUpdate = window.wushuState.matches[window.wushuState.bertandingIdx];
                matchUpdate.status = 'selesai';
                matchUpdate.winnerSide = winner;
                matchUpdate.winner = winner === 'merah' ? matchUpdate.m : matchUpdate.b;
                window.broadcast(`matches/${window.wushuState.bertandingIdx}`, matchUpdate);
            }
        }, 300);
    }

    window.resolveChallenge = function(accepted) {
        window.closeModal('modal-challenge');
        if(accepted) alert("Protes Diterima.\nSilahkan sesuaikan skor yang salah menggunakan tombol -1 / +1 di Dashboard Utama Dewan.");
        else {
            alert("Protes Ditolak. Pertandingan dilanjutkan.");
            window.broadcast('isRunning', true);
        }
    }
</script>
</body>
</html>
